# 复制为 .env 并填写实际值（新项目推荐直接用 scripts/init-project.sh 生成）
# cp .env.example .env
#
# ⚠️ 新增/删除配置项时，必须同步 .github/workflows/deploy.yml 里「写入 .env」的键列表，
#    否则该变量在生产上是空值。CI 会自动校验两边一致性，不一致直接失败。
#
# ─────────────────────────────────────────────────────────
# 🔴 新项目必须修改（项目身份标识，不改等于还是模板项目）
# ─────────────────────────────────────────────────────────

# 项目显示名（用于页面标题、邮件等处）
PROJECT_NAME="英语口语评测平台"

# Docker Compose 项目名（决定容器名前缀，如 xxx-backend-1）
# 同一台机器上多个项目不能重复，否则容器/网络/卷会互相覆盖
# 只允许小写字母、数字、短横线；init-project.sh 会从 PROJECT_NAME 自动推导
COMPOSE_PROJECT_NAME=english-speaking-assessment

# ─────────────────────────────────────────────────────────
# 🟡 强烈建议修改（安全相关；纯离线内部用可延后，但上线前一定要改）
# ─────────────────────────────────────────────────────────

# JWT 签名密钥（外网可访问时必须是随机长字符串，绝不能用 changethis）
SECRET_KEY=changethis

# 初始管理员账号（首次启动时创建）
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

# 数据库密码
POSTGRES_PASSWORD=changethis

# ─────────────────────────────────────────────────────────
# 🟢 部署时按实际情况填写
# ─────────────────────────────────────────────────────────

# 前端地址（开发时是 localhost:5173，正式部署时改为实际域名，如 https://example.com）
FRONTEND_HOST=http://localhost:5173

# 运行环境: local | staging | production
ENVIRONMENT=local

# 允许跨域的前端地址（多个用逗号分隔）
BACKEND_CORS_ORIGINS="http://localhost,http://localhost:5173,http://localhost:80"

# 是否开放自助注册
# 本地开着便于开发演示；生产默认关，需要时在 GitHub Secrets 设为 true
USERS_OPEN_REGISTRATION=true

# ─────────────────────────────────────────────────────────
# ⚪ 可选配置（按需填写，不填则使用默认值或禁用对应功能）
# ─────────────────────────────────────────────────────────

# 邮件配置（全部留空则禁用邮件功能，密码重置等邮件相关功能不可用）
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=True
SMTP_SSL=False
SMTP_PORT=587

# 数据库连接（一般不用改，db 是 compose 内部服务名）
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=postgres

# Sentry 错误监控 DSN（留空则不启用）
SENTRY_DSN=

# Docker 暴露端口（生产用 80，本地有冲突可改）
APP_PORT=80

# 后端 worker 进程数（默认 1，生产大流量可调至 cpu核数×2+1）
WORKERS=1

# ── 口语评测评分引擎（PRD §7.2：可替换接口后切换）──
# mock=离线演示/测试（不调云）；ark=火山方舟（转写 + rubric 评分）
# 切 ark 前需：方舟控制台开通模型推理 + 配好 ARK_API_KEY
SCORING_PROVIDER=mock
# 火山方舟 API Key（只在后端使用，绝不进前端）
ARK_API_KEY=
# 音频转写模型：API 调用名必须带日期后缀（广场短名会 404）
ARK_ASR_MODEL=doubao-seed-2-0-lite-260428
# 开放题 rubric 评分模型（chat 接口，与转写模型可同可不同）
ARK_RUBRIC_MODEL=doubao-seed-2-0-lite-260428
# ── 标准音合成（TTS）：走 vei AI 网关，与方舟是两套密钥 ──
# 开通：console.volcengine.com/vei/aigateway → 创建访问密钥（ARK_TTS_API_KEY）
# 不配置时 TTS 生成报 503，上传现成音频的通道不受影响
ARK_TTS_API_KEY=
ARK_TTS_MODEL=doubao-tts
# 音色在控制台「音色列表」试听选择后填写（bigtts 系命名，如 en_female_xxx）
ARK_TTS_VOICE=
